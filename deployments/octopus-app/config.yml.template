  database:
  username:
  password:

# Optional: the IANA timezone that defines a "local day" (default Europe/London).
# Must match hive-app's timezone setting.
# timezone: Europe/London

# Optional: when the room forecast's comfort plan holds the comfort temperature, in
# local time, one window per day (defaults shown). An end at or before the start is
# the next morning ("00:00" is midnight at the end of the day). Quote every time:
# YAML reads an unquoted 7:45 as the number 465 and the app refuses to start. The forecast steps in 2 minutes, so
# a time on an odd minute is rounded earlier to an even one (07:45 becomes 07:44)
# and the log says so; a window whose different start and end round to the same
# mark is refused at startup.
# comfort_windows:
#   monday:
#     start: "07:30"
#     end: "23:00"
#   tuesday:
#     start: "07:30"
#     end: "23:00"
#   wednesday:
#     start: "07:30"
#     end: "23:00"
#   thursday:
#     start: "07:30"
#     end: "23:00"
#   friday:
#     start: "07:30"
#     end: "00:30"
#   saturday:
#     start: "08:30"
#     end: "00:30"
#   sunday:
#     start: "08:30"
#     end: "23:00"

data_refresh:
  retention_days: 45
  refresh_interval_hours: 1
