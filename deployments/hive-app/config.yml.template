hive:
  username:
  password:
  # Optional -- the default (/config/hive_auth_state.json) is fine for most
  # deployments; hive-app's /config bind mount already exists.
  # auth_state_path: /config/hive_auth_state.json

mariadb:
  host:
  port:
  database:
  username:
  password:

# Everything below is optional -- omit these sections entirely for a
# #506-only deployment (heating status polling doesn't use any of them).
# Open-Meteo needs no API key -- only Weather Underground and ntfy.sh do.

# Weather Underground station credentials, used by weather_observation_refresh.
weather_underground:
  api_key:
  station_id:

# ntfy.sh topic used for the two hive-app notifications: "re-authentication
# required" (links to deployments/hive-app/REAUTH_RUNBOOK.md) and
# "authentication recovered". ntfy.sh topics are public -- the GUID is the only
# secret, so keep the real URL only in the Pi's config.yml, never in the repo.
# Topic format: home-monitoring-hive-auth-ntfy-<guid-no-dashes>, e.g.
#   topic_url: https://ntfy.sh/home-monitoring-hive-auth-ntfy-<32 lowercase hex chars>
# Generate one with: uuidgen | tr -d '-' | tr 'A-F' 'a-f'
ntfy:
  topic_url:

# Household lat/long, used by weather_observation_refresh (and, once it
# ships, weather forecast polling).
location:
  latitude:
  longitude:
